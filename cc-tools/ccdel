#!/usr/bin/env python3
"""ccdel <name-or-id-prefix> — delete a session (transcript + subagent dir + rewind).

Was a zsh script tied to the Mac hub; now Python so it runs on Windows too.
The config dir is derived from cclib.ROOT, so it follows CLAUDE_CONFIG_DIR and
the hub the same way every other tool here does."""
import os
import shutil
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from cclib import ROOT, resolve

if len(sys.argv) < 2:
    print("usage: ccdel <session-name-or-id-prefix>")
    sys.exit(1)

matches = resolve(sys.argv[1])
if not matches:
    print("no session matching '%s'" % sys.argv[1])
    sys.exit(1)
if len(matches) > 1:
    print("ambiguous:")
    for s in matches:
        print("  %s  %s  %s" % (s['sid'][:8], s['title'] or '(unnamed)', s['proj']))
    sys.exit(1)

s = matches[0]
CONFIG = os.path.dirname(ROOT)
targets = [
    s['file'],
    s['file'][:-6],                                    # subagent dir
    os.path.join(CONFIG, 'file-history', s['sid']),    # rewind history
    os.path.join(CONFIG, 'image-cache', s['sid'])
]


def size_of(path):
    if os.path.isfile(path):
        return os.path.getsize(path)
    total = 0
    for root, _, files in os.walk(path):
        for name in files:
            try:
                total += os.path.getsize(os.path.join(root, name))
            except OSError:
                pass
    return total


def human(n):
    for unit in ('B', 'K', 'M', 'G'):
        if n < 1024 or unit == 'G':
            return '%.0f%s' % (n, unit) if unit == 'B' else '%.1f%s' % (n, unit)
        n /= 1024


print("session : %s" % (s['title'] or '(unnamed)'))
print("id      : %s" % s['sid'])
print("project : %s" % s['proj'])
print("size    : %s transcript, %s subagents, %s rewind"
      % (human(size_of(targets[0])), human(size_of(targets[1])),
         human(size_of(targets[2]) + size_of(targets[3]))))

if input("delete? [y/N] ").strip().lower() != 'y':
    print("aborted")
    sys.exit(0)

for path in targets:
    try:
        if os.path.isdir(path):
            shutil.rmtree(path)
        elif os.path.isfile(path):
            os.remove(path)
    except OSError as exc:
        print("could not remove %s (%s)" % (path, exc))

print("deleted")
