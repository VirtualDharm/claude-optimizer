#!/bin/zsh
# ram — Task-Manager for macOS terminal.
#
#   ram              dashboard: memory / swap / disk + top apps
#   ram -w           live mode, refreshes every 2s (Ctrl-C to exit)
#   ram -c           CPU-sorted instead of memory-sorted
#   ram -n 25        show N rows (default 15)
#   ram -i           interactive: pick a number to quit that app
#   ram <name>       quit apps matching <name>   (graceful, then force)
#   ram clean        free inactive memory + purge user caches
#
# Never kills macOS-critical processes (see PROTECTED).

emulate -L zsh
setopt no_nomatch

R=$'\033[0m'; B=$'\033[1m'; DIM=$'\033[2m'
RED=$'\033[38;5;203m'; YEL=$'\033[38;5;221m'; GRN=$'\033[38;5;114m'
BLU=$'\033[38;5;75m';  MAG=$'\033[38;5;176m'; GRY=$'\033[38;5;245m'

PROTECTED='kernel_task|WindowServer|loginwindow|launchd|SystemUIServer|Finder|Dock|coreaudiod|Terminal|iTerm'

ROWS=15; SORT=mem; MODE=dash; TARGET=""; ALL=""; PORT=""
while (( $# )); do
  case "$1" in
    -w|--watch)  MODE=watch ;;
    -c|--cpu)    SORT=cpu ;;
    -a|--all)    ALL=all ;;
    -i|--pick)   MODE=pick ;;
    -n)          shift; ROWS=$1 ;;
    -h|--help)   MODE=help ;;
    clean)       MODE=clean ;;
    disk|-d)     MODE=disk ;;
    ports|-p)    MODE=ports ;;
    port)        MODE=ports; if (( $# > 1 )); then shift; PORT=$1; fi ;;
    big)         MODE=big ;;
    *)           TARGET="$1"; MODE=kill ;;
  esac
  shift
done

# ── helpers ───────────────────────────────────────────────────────────────
bar() {  # bar <pct> <width> <color>
  local pct=$1 width=$2 col=$3 filled i out=""
  filled=$(( pct * width / 100 )); (( filled > width )) && filled=$width
  for (( i=0; i<filled; i++ )); do out+="█"; done
  for (( i=filled; i<width; i++ )); do out+="·"; done
  print -n -- "${col}${out}${R}"
}

heat() { # color by pct used: green→yellow→red
  local p=$1
  if   (( p >= 85 )); then print -n -- "$RED"
  elif (( p >= 65 )); then print -n -- "$YEL"
  else print -n -- "$GRN"; fi
}

# app-name grouping: all helpers of one .app collapse into one row
collect() {  # collect [all]  — groups helper processes under their .app name
  ps -Axo rss,pcpu,args 2>/dev/null | awk -v showall="${1:-}" '
    NR>1 {
      rss=$1; cpu=$2; app="";
      # ".app" only counts when followed by "/" or end-of-token — stops
      # "com.apple.foo" from matching ".app" and collapsing to "com".
      if (match($0, /\/[^\/]+\.app\//)) {
        m = substr($0, RSTART+1, RLENGTH-6);          # strip / and .app/
        app = m;
      } else {
        n = split($3, p, "/"); app = p[n];
        sub(/\.app$/, "", app);
      }
      gsub(/^-/, "", app);
      if (app == "" || app ~ /^[0-9.]+$/) next;
      # background daemons: hidden unless `ram -a`
      if (showall == "" && $0 ~ /\/(usr\/libexec|System\/Library\/(PrivateFrameworks|CoreServices|Frameworks))\//) next;
      mem[app]+=rss; pc[app]+=cpu;
    }
    END { for (a in mem) printf "%d\t%.1f\t%s\n", mem[a], pc[a], a }'
}

# ── dashboard ─────────────────────────────────────────────────────────────
dashboard() {
  local total_gb free_pct used_pct swap_used swap_tot disk_free disk_pct
  total_gb=$(sysctl -n hw.memsize | awk '{printf "%.0f", $1/1073741824}')
  free_pct=$(memory_pressure 2>/dev/null | awk -F': ' '/free percentage/{gsub(/%/,"",$2); print $2+0}')
  [[ -z $free_pct ]] && free_pct=50
  used_pct=$(( 100 - free_pct ))
  swap_used=$(sysctl -n vm.swapusage | awk '{gsub(/M/,"",$6); printf "%.0f", $6}')
  swap_tot=$(sysctl -n vm.swapusage  | awk '{gsub(/M/,"",$3); printf "%.0f", $3}')
  disk_free=$(df -g / | awk 'NR==2{print $4}')
  disk_pct=$(df / | awk 'NR==2{gsub(/%/,"",$5); print $5}')

  print ""
  print -- "  ${B}${BLU}▍SYSTEM${R}  ${DIM}$(date '+%H:%M:%S')${R}"
  print ""
  printf "  %-6s " "RAM"
  bar $used_pct 24 "$(heat $used_pct)"
  printf "  %s%d%%%s used of %sGB   ${DIM}free %d%%${R}\n" "$(heat $used_pct)" $used_pct "$R" "$total_gb" $free_pct

  local swap_pct=0
  (( swap_tot > 0 )) && swap_pct=$(( swap_used * 100 / swap_tot ))
  printf "  %-6s " "SWAP"
  bar $swap_pct 24 "$(heat $swap_pct)"
  printf "  %s%dMB%s of %dMB\n" "$(heat $swap_pct)" $swap_used "$R" $swap_tot

  printf "  %-6s " "DISK"
  bar $disk_pct 24 "$(heat $disk_pct)"
  printf "  %s%d%%%s used   ${DIM}${disk_free}GB free${R}" "$(heat $disk_pct)" $disk_pct "$R"
  # swap files live on disk — big swap silently eats free space
  local swapfiles_mb
  swapfiles_mb=$(du -sm /private/var/vm 2>/dev/null | awk '{print $1}')
  if [[ -n $swapfiles_mb ]] && (( swapfiles_mb > 1024 )); then
    printf "   ${YEL}swapfiles %.1fGB${R}" "$(( swapfiles_mb ))e-3"
  fi
  print ""

  # verdict line
  print ""
  if   (( used_pct >= 88 || swap_used > 3000 )); then
    print -- "  ${RED}${B}⚠  CRITICAL${R} ${RED}— quit a top app now:  ram <name>${R}"
  elif (( used_pct >= 70 || swap_used > 1000 )); then
    print -- "  ${YEL}⚠  tight${R} ${DIM}— swapping to disk; close what you're not using${R}"
  else
    print -- "  ${GRN}✓  healthy${R}"
  fi

  # ── process table ───────────────────────────────────────────────────────
  local sortcol=1; [[ $SORT == cpu ]] && sortcol=2
  print ""
  printf "  ${B}%-3s %-26s %10s %8s   %s${R}\n" "#" "APP" "MEMORY" "CPU" "SHARE"
  print -- "  ${DIM}─────────────────────────────────────────────────────────────────${R}"

  local total_mb=$(( total_gb * 1024 ))
  local i=1
  collect $ALL | sort -t$'\t' -k${sortcol} -rn | head -$ROWS | while IFS=$'\t' read -r kb cpu app; do
    local mb=$(( kb / 1024 ))
    local share=$(( mb * 100 / total_mb ))
    local col=$GRY
    (( mb > 500 )) && col=$YEL
    (( mb > 1200 )) && col=$RED
    local shown=$app
    (( ${#shown} > 25 )) && shown="${shown[1,24]}…"
    printf "  ${DIM}%-3s${R} ${col}%-26s${R} %8dMB %7s%%   " "$i" "$shown" "$mb" "$cpu"
    bar $share 12 "$col"
    print ""
    (( i++ ))
  done
  print ""
  print -- "  ${DIM}ram -w${R} live   ${DIM}ram -c${R} by CPU   ${DIM}ram -i${R} pick & quit   ${DIM}ram -a${R} incl. daemons   ${DIM}ram ports${R} ports   ${DIM}ram disk${R} storage   ${DIM}ram clean${R} free memory"
  print ""
}

# ── graceful quit ─────────────────────────────────────────────────────────
quit_match() {
  local target="$1"
  if [[ "$target" =~ ^($PROTECTED)$ ]] || [[ "${target:l}" == "finder" ]]; then
    print -- "  ${RED}refused${R} — '$target' is a macOS-critical process"
    return 1
  fi
  local matches
  matches=$(collect all | awk -v t="${target:l}" 'BEGIN{IGNORECASE=1} tolower($0) ~ t {print $3}' | head -5)
  [[ -z $matches ]] && { print -- "  ${YEL}nothing matched${R} '$target'"; return 1; }

  local before after freed
  before=$(memory_pressure 2>/dev/null | awk -F': ' '/free percentage/{gsub(/%/,"",$2); print $2+0}')

  print -- "  quitting: ${B}${matches//$'\n'/, }${R}"
  # 1) polite AppleScript quit (lets apps save state)
  print -r -- "$matches" | while read -r app; do
    osascript -e "tell application \"$app\" to quit" 2>/dev/null
  done
  sleep 2
  # 2) force whatever survived
  pkill -i -f "$target" 2>/dev/null
  sleep 1

  after=$(memory_pressure 2>/dev/null | awk -F': ' '/free percentage/{gsub(/%/,"",$2); print $2+0}')
  freed=$(( after - before ))
  if (( freed > 0 )); then
    print -- "  ${GRN}✓ done${R} — free memory ${before}% → ${GRN}${after}%${R} (+${freed})"
  else
    print -- "  ${GRN}✓ done${R} ${DIM}(free ${after}%)${R}"
  fi
}

# ── clean ─────────────────────────────────────────────────────────────────
do_clean() {
  print ""
  print -- "  ${B}${BLU}▍CLEAN${R}"
  local b=$(memory_pressure 2>/dev/null | awk -F': ' '/free percentage/{gsub(/%/,"",$2); print $2+0}')
  local d0=$(df -g / | awk 'NR==2{print $4}')

  print -n -- "  purging inactive memory… "
  sudo -n purge 2>/dev/null && print -- "${GRN}ok${R}" || print -- "${DIM}skipped (needs: sudo purge)${R}"

  print -n -- "  browser + app caches… "
  rm -rf "$HOME/Library/Caches/net.whatsapp.WhatsApp"/* 2>/dev/null
  rm -rf "$HOME/Library/Caches/BraveSoftware"/* 2>/dev/null
  rm -rf "$HOME/Library/Caches/com.apple.Safari"/* 2>/dev/null
  rm -rf "$HOME/Library/Application Support/Code/Cache" 2>/dev/null
  rm -rf "$HOME/Library/Application Support/Code/CachedData" 2>/dev/null
  print -- "${GRN}ok${R}"

  print -n -- "  npm cache… "
  npm cache clean --force >/dev/null 2>&1 && print -- "${GRN}ok${R}" || print -- "${DIM}n/a${R}"

  local a=$(memory_pressure 2>/dev/null | awk -F': ' '/free percentage/{gsub(/%/,"",$2); print $2+0}')
  local d1=$(df -g / | awk 'NR==2{print $4}')
  print ""
  print -- "  memory free ${b}% → ${GRN}${a}%${R}    disk ${d0}GB → ${GRN}${d1}GB${R}"
  print ""
}

# ── disk breakdown ────────────────────────────────────────────────────────
disk_view() {
  local disk_free disk_pct total_gb
  disk_free=$(df -g / | awk 'NR==2{print $4}')
  disk_pct=$(df / | awk 'NR==2{gsub(/%/,"",$5); print $5}')

  print ""
  print -- "  ${B}${BLU}▍DISK${R}  ${DIM}$(date '+%H:%M:%S')${R}"
  print ""
  printf "  %-6s " "USED"
  bar $disk_pct 24 "$(heat $disk_pct)"
  printf "  %s%d%%%s   ${DIM}${disk_free}GB free${R}\n" "$(heat $disk_pct)" $disk_pct "$R"
  print ""
  print -- "  ${DIM}scanning…${R}"

  # (label, path) pairs — cheap targeted du beats a full-disk scan
  local -a targets=(
    "Downloads:$HOME/Downloads"
    "WhatsApp data:$HOME/Library/Group Containers/group.net.whatsapp.WhatsApp.shared"
    "Brave profile:$HOME/Library/Application Support/BraveSoftware"
    "All caches:$HOME/Library/Caches"
    "App Support:$HOME/Library/Application Support"
    "Applications:/Applications"
    "Swap files:/private/var/vm"
    "Xcode CLT:/Library/Developer"
    "Docs+Desktop:$HOME/Documents"
    "npm cache:$HOME/.npm"
  )
  for p in $HOME/Projects*(N/); do targets+=("$(basename $p):$p"); done

  local -a rows=()
  for t in $targets; do
    local label="${t%%:*}" dpath="${t#*:}"
    [[ -e $dpath ]] || continue
    local mb=$(du -sm "$dpath" 2>/dev/null | awk '{print $1}')
    [[ -n $mb ]] && (( mb > 50 )) && rows+=("$mb|$label|$dpath")
  done

  [[ -t 1 ]] && printf "\033[2A\033[K"   # erase "scanning…" (only on a real terminal)
  printf "  ${B}%-22s %10s   %s${R}\n" "WHAT" "SIZE" "SHARE OF DISK"
  print -- "  ${DIM}──────────────────────────────────────────────────────────${R}"
  local max_mb=$(print -l -- $rows | cut -d'|' -f1 | sort -rn | head -1)
  (( max_mb < 1 )) && max_mb=1
  print -l -- $rows | sort -t'|' -k1 -rn | head -14 | while IFS='|' read -r mb label dpath; do
    local share=$(( mb * 100 / max_mb ))
    local col=$GRY
    (( mb > 1024 )) && col=$YEL
    (( mb > 4096 )) && col=$RED
    local size=""
    if (( mb >= 1024 )); then size=$(printf "%.1fG" "$(( mb ))e-3"); else size="${mb}M"; fi
    printf "  ${col}%-22s${R} %10s   " "$label" "$size"
    bar $share 14 "$col"
    print ""
  done

  # node_modules across personal projects (never Projects3 = office work)
  local nm_mb=0
  for d in $HOME/Projects2/**/node_modules(N/) $HOME/Projects4/**/node_modules(N/); do
    local m=$(du -sm "$d" 2>/dev/null | awk '{print $1}'); nm_mb=$(( nm_mb + m ))
  done

  print ""
  print -- "  ${B}QUICK WINS${R}"
  local shown=0
  _win() { print -- "  ${GRN}•${R} $1"; shown=1 }
  local wa=$(du -sm "$HOME/Library/Group Containers/group.net.whatsapp.WhatsApp.shared/Message" 2>/dev/null | awk '{print $1}')
  (( ${wa:-0} > 500 ))  && _win "WhatsApp media ${wa}MB   ${DIM}rm -rf ~/Library/'Group Containers'/group.net.whatsapp.WhatsApp.shared/Message/*${R}"
  local ca=$(du -sm "$HOME/Library/Caches" 2>/dev/null | awk '{print $1}')
  (( ${ca:-0} > 1000 )) && _win "caches ${ca}MB   ${DIM}ram clean${R}"
  (( nm_mb > 500 ))     && _win "node_modules ${nm_mb}MB in Projects2/4   ${DIM}npx npkill${R}"
  local sw=$(du -sm /private/var/vm 2>/dev/null | awk '{print $1}')
  (( ${sw:-0} > 3000 )) && _win "swap files ${sw}MB — ${DIM}restart the Mac to reclaim${R}"
  local dl=$(du -sm "$HOME/Downloads" 2>/dev/null | awk '{print $1}')
  (( ${dl:-0} > 2000 )) && _win "Downloads ${dl}MB   ${DIM}ram disk big${R} to list files >100MB"
  (( shown == 0 )) && print -- "  ${DIM}nothing obvious — disk is in good shape${R}"

  print ""
  print -- "  ${DIM}ram disk big${R} biggest files   ${DIM}ram clean${R} purge caches   ${DIM}ram${R} memory view"
  print ""
}

big_files() {
  print ""
  print -- "  ${B}${BLU}▍BIGGEST FILES${R} ${DIM}>100MB under ~ (excludes Projects3 office work)${R}"
  print ""
  find "$HOME" -type f -size +100M \
       -not -path "*/Projects3/*" -not -path "*/Library/Caches/*" 2>/dev/null |
  while read -r f; do
    local mb=$(du -m "$f" 2>/dev/null | awk '{print $1}')
    print -- "$mb|$f"
  done | sort -t'|' -k1 -rn | head -20 | while IFS='|' read -r mb f; do
    local col=$GRY; (( mb > 1024 )) && col=$YEL; (( mb > 3072 )) && col=$RED
    local size=""; if (( mb >= 1024 )); then size=$(printf "%.1fG" "$(( mb ))e-3"); else size="${mb}M"; fi
    printf "  ${col}%8s${R}  %s\n" "$size" "${f/#$HOME/~}"
  done
  print ""
}

# ── ports ─────────────────────────────────────────────────────────────────
ports_view() {   # ports_view [portnumber]  — list listeners, or free one port
  local want="$1"

  if [[ -n $want ]]; then
    local pids
    pids=$(lsof -nP -iTCP:"$want" -sTCP:LISTEN -t 2>/dev/null)
    if [[ -z $pids ]]; then
      print -- "  ${GRN}port $want is free${R}"
      return 0
    fi
    print -r -- "$pids" | while read -r pid; do
      local cmd=$(ps -p "$pid" -o comm= 2>/dev/null | sed 's|.*/||')
      local full=$(ps -p "$pid" -o args= 2>/dev/null | cut -c1-70)
      print -- "  killing ${B}$cmd${R} (pid $pid)  ${DIM}$full${R}"
      kill "$pid" 2>/dev/null
    done
    sleep 1
    # anything that ignored SIGTERM gets SIGKILL
    local left=$(lsof -nP -iTCP:"$want" -sTCP:LISTEN -t 2>/dev/null)
    [[ -n $left ]] && { print -r -- "$left" | xargs kill -9 2>/dev/null; sleep 1 }
    if lsof -nP -iTCP:"$want" -sTCP:LISTEN -t >/dev/null 2>&1; then
      print -- "  ${RED}still occupied${R} — may belong to another user/root"
    else
      print -- "  ${GRN}✓ port $want is now free${R}"
    fi
    return 0
  fi

  print ""
  print -- "  ${B}${BLU}▍LISTENING PORTS${R}"
  print ""
  printf "  ${B}%-8s %-22s %8s   %s${R}\n" "PORT" "PROCESS" "PID" "COMMAND"
  print -- "  ${DIM}──────────────────────────────────────────────────────────────────${R}"
  lsof -nP -iTCP -sTCP:LISTEN 2>/dev/null | awk 'NR>1 {
      split($9, a, ":"); port = a[length(a)];
      key = port "\t" $1 "\t" $2;
      if (!(key in seen)) { seen[key]=1; print key }
    }' | sort -n | while IFS=$'\t' read -r port proc pid; do
    local args=$(ps -p "$pid" -o args= 2>/dev/null | sed "s|$HOME|~|g" | cut -c1-42)
    local col=$GRY
    # dev-server ports worth noticing
    case $port in
      3000|3001|4200|5173|8000|8080|5000|9000) col=$YEL ;;
    esac
    printf "  ${col}%-8s${R} %-22s %8s   ${DIM}%s${R}\n" "$port" "${proc:0:21}" "$pid" "$args"
  done
  print ""
  print -- "  ${DIM}ram port 4200${R} free that port   ${DIM}ram ports${R} refresh"
  print ""
}

# ── interactive pick ──────────────────────────────────────────────────────
pick() {
  dashboard
  print -n -- "  ${B}number to quit${R} ${DIM}(Enter = cancel):${R} "
  read -r n
  [[ -z $n ]] && { print -- "  cancelled"; return; }
  local app
  app=$(collect $ALL | sort -rn | head -$ROWS | sed -n "${n}p" | cut -f3)
  [[ -z $app ]] && { print -- "  ${YEL}no row $n${R}"; return; }
  quit_match "$app"
}

case $MODE in
  help)
    print ""
    print -- "  ${B}ram${R} — macOS Task Manager for the terminal"
    print ""
    print -- "  ${B}ram${R}            dashboard: RAM / swap / disk + top apps"
    print -- "  ${B}ram -w${R}         live mode, refresh 2s (Ctrl-C exits)"
    print -- "  ${B}ram -c${R}         sort by CPU instead of memory"
    print -- "  ${B}ram -n 25${R}      show 25 rows"
    print -- "  ${B}ram -a${R}         include background system daemons"
    print -- "  ${B}ram -i${R}         interactive — pick a number to quit"
    print -- "  ${B}ram <name>${R}     quit apps matching name  (ram brave)"
    print -- "  ${B}ram clean${R}      purge inactive memory + app caches"
    print -- "  ${B}ram disk${R}       disk breakdown + quick wins"
    print -- "  ${B}ram disk big${R}   list files over 100MB"
    print -- "  ${B}ram ports${R}      what is listening on which port"
    print -- "  ${B}ram port 4200${R}  kill whatever holds that port"
    print ""
    ;;
  watch)  while true; do clear; dashboard; sleep 2; done ;;
  kill)   quit_match "$TARGET" ;;
  clean)  do_clean ;;
  disk)   disk_view ;;
  ports)  ports_view "$PORT" ;;
  big)    big_files ;;
  pick)   pick ;;
  *)      dashboard ;;
esac
